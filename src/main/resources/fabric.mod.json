{
  "schemaVersion": 1,
  "id": "fastimageframes",
  "version": "${version}",
  "name": "Fast ImageFrames",
  "description": "Client-side only. Makes item frames and map walls (ImageFrame, map art) much cheaper to render, with no visual difference. Works with ImageFrame Client, Sodium and Iris.",
  "authors": [
    "Palmine38"
  ],
  "contact": {
    "sources": "https://github.com/Palmine38/FastImageFrame"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fastimageframes.FastImageFrames"
    ],
    "modmenu": [
      "fastimageframes.modmenu.FastImageFramesModMenu"
    ]
  },
  "mixins": [
    "fastimageframes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "breaks": {
    "voltum": "<1.1.0"
  },
  "suggests": {
    "imageframeclient": "*",
    "modmenu": "*"
  }
}
